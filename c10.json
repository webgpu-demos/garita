function formatLomc(lomcdata){
	
	var lomchtml = "";
	if(typeof lomcdata != "undefined" && lomcdata != null) {
	  for(var lomcList = 0; lomcList < lomcdata.length; lomcList ++) {
	        var lomcrow = lomcdata[lomcList];
			lomchtml = "<tr class='even'>" +
				'<td class=""> ' + lomcrow.c_PRODUCT_NAME + '</td>'+
				'<td class="text-center"> ' + lomcrow.c_PRODUCT_EFFECTIVE_DATE_STRING + '</td>'+
				'<td class=""> ' + lomcrow.c_PRODUCT_SUBTYPE_ID + '</td>'+
				'<td class=""></td>' +
				'<td class=""> ' +
					 '<a href="/portal/downloadProduct?productTypeID=' + lomcrow.c_PRODUCT_TYPE_ID + 
					 '&productSubTypeID=' + lomcrow.c_PRODUCT_SUBTYPE_ID +
					 '&productID='+ lomcrow.c_PRODUCT_NAME + 
					 '" target="_blank"><img src="/portal/images/btn-download.png" alt="DL:Download Product '+ lomcrow.c_PRODUCT_NAME +'" /></a>' +
				'</td>' +
				'<td class=""></td>' +
				'</tr>' + lomchtml;     
	  }
	}
	return lomchtml;
}



function search(){
	    
	 
	//validation
 	var validation = validate();
	if(!validation) {
		
		return;
	}
	 
	var searchString = getSearchString();
	console.log("searchString: " + searchString);

	console.log("WE ARE IN THE SEARCH FUNCTION");
	if(compareString != null || compareString != ''){
		compareString = '';
		console.log("Previous string detected. Switching compareString to default.");
	}
	console.log("searchedCid: " + document.getElementById("searchedCid").value);
	console.log("jurisdictionvalue: " + document.getElementById("jurisdictionvalue").value);
	console.log("countyVal: " + countyVal);
	//assign compare string for selected county sort
	var barCount = 0;
	for(let i = 0; i < document.getElementById("jurisdictionvalue").value.length; i++){
		if(document.getElementById("jurisdictionvalue").value[i] == '|'){
			barCount++;
		}
		if(barCount == 3 && document.getElementById("jurisdictionvalue").value[i] != '|'){
			compareString += document.getElementById("jurisdictionvalue").value[i];
		}
	}
	if(countyVal != null && compareString == ''){
		compareString = countyVal;
	}
	//^^ need to find county value when user searches city via dropdown
	console.log("compareString is : "+compareString);
	//sort effFirmTable table per RSA-7861 Sort products in Search All Products better for "All Jurisdictions" searches
	if((effFirmTable != null) && (compareString != null)){
		console.log("COMPARE STRING is ::: "+ compareString);
		//sortTable(effFirmTable, compareString);
	}

	setSearchCriteria();
	
	//reset
	reset();

    jQuery.ajax({
    	 beforeSend: function(){
    		 jQuery('#mainSearch').prop('disabled', true);
    		 	jQuery("#wait").css("display","block");
    		},
    		complete: function(){
    			 jQuery("#wait").css("display","none");
